<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>QuartzSupervisor</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <AssemblyName>QuartzSupervisor</AssemblyName>
    <Description>Embedded Quartz.NET scheduler dashboard for ASP.NET Core applications, with job and trigger management, scheduler controls, and live execution events.</Description>
    <PackageTags>quartz;quartznet;dashboard;scheduler;monitoring;aspnetcore;blazor</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../QuartzSupervisor.Integration/QuartzSupervisor.Integration.csproj" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
