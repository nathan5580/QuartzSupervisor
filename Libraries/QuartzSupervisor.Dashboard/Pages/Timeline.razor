@page "/quartz-supervisor/timeline"
@using System.Globalization
<PageTitle>Timeline · Quartz Supervisor</PageTitle>

<main class="page" id="main-content" tabindex="-1">
    <header class="page-heading">
        <div>
            <h1>Timeline</h1>
            <p class="page-description">Live scheduler activity · oldest on the left, newest on the right.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-panel" role="status"><span class="loading-dot"></span>Loading scheduler activity…</p>
    }
    else if (_error is not null)
    {
        <p class="notice" role="alert">@_error</p>
    }
    else if (_schedulers.Count == 0)
    {
        <p class="notice">No schedulers are registered with this host.</p>
    }
    else
    {
        <section class="filter-panel timeline-filter" aria-label="Timeline filters">
            <div class="filter-field">
                <label for="timeline-scheduler">Scheduler</label>
                <select id="timeline-scheduler" class="field" @bind="_selectedName" @bind:after="RefreshActivity">
                    <option value="">All schedulers</option>
                    @foreach (var scheduler in _schedulers) { <option value="@scheduler.Name">@(scheduler.Status == "Unavailable" ? $"{scheduler.Name} (Unavailable)" : scheduler.Name)</option> }
                </select>
            </div>
            <p class="timeline-retention">Up to 100 recent events per scheduler · memory only · cleared when the host restarts</p>
        </section>

        <section class="timeline-panel" aria-labelledby="timeline-heading">
            <div class="panel-header">
                <div>
                    <h2 id="timeline-heading">Recent activity</h2>
                    <p class="panel-description" aria-live="polite"><span class="timeline-live" aria-hidden="true"></span>Live · @_activity.Count event@(_activity.Count == 1 ? "" : "s")</p>
                </div>
            </div>
            @if (_activity.Count == 0)
            {
                <div class="empty-state">
                    <h3>Waiting for scheduler activity</h3>
                    <p>Quartz events will appear here as jobs run or scheduler state changes. Only activity observed after this dashboard connects is shown.</p>
                </div>
            }
            else
            {
                <div class="timeline-scroll" @ref="_timelineScroll" role="region" aria-label="Live scheduler events, oldest on the left. Scroll horizontally for recent events." tabindex="0">
                    <ol class="timeline-list" aria-label="Recent scheduler activity">
                        @foreach (var item in _activity.Reverse())
                    {
                        <li class="timeline-item" data-error="@item.IsError.ToString().ToLowerInvariant()">
                            <span class="timeline-marker" aria-hidden="true"></span>
                            <div class="timeline-entry">
                                <div class="timeline-entry-heading">
                                    <span class="timeline-category">@item.Category</span>
                                    <time datetime="@item.TimestampUtc.ToString("O", CultureInfo.InvariantCulture)">@FormatTimestamp(item.TimestampUtc)</time>
                                </div>
                                <p>@item.Message</p>
                                <span class="timeline-scheduler">@item.SchedulerName</span>
                            </div>
                        </li>
                    }
                </ol>
                </div>
            }
        </section>
    }
</main>
