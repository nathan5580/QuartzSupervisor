@page "/timeline"
<PageTitle>Timeline · @Context.Title</PageTitle>
<main class="page" id="main-content" tabindex="-1">
    <header class="page-heading"><div><h1>Timeline</h1><p class="page-description">Runs and upcoming schedules.</p></div></header>
    <form class="toolbar" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
        <div class="form-field"><label for="timeline-search">Job or trigger filter</label><input id="timeline-search" type="search" maxlength="200" @bind="_search" /></div>
        <details class="form-field"><summary>Custom date range</summary><div class="form-grid">
            <div class="form-field"><label for="timeline-from">From (UTC)</label><input id="timeline-from" type="datetime-local" @bind="_inputFrom" required /></div>
            <div class="form-field"><label for="timeline-to">To (UTC)</label><input id="timeline-to" type="datetime-local" @bind="_inputTo" required /></div>
        </div></details>
        <div class="form-field"><label for="timeline-zone">Display times</label><select id="timeline-zone" @bind="_zone"><option value="utc">UTC</option><option value="local">Browser local time</option></select></div>
        <button class="button-primary" type="submit">Apply</button>
    </form>
    <div class="toolbar-actions" aria-label="Timeline range and view">
        <button class="button-secondary" @onclick="() => Preset(1d / 12)">10 minutes</button>
        <button class="button-secondary" @onclick="() => Preset(1)">2 hours</button>
        <button class="button-secondary" @onclick="() => Preset(12)">24 hours</button>
        <button class="button-secondary" @onclick="() => Preset(144)">7 days</button>
        <button class="button-secondary button-icon" aria-label="Earlier time range" title="Earlier time range" @onclick="() => ChangeRange(1, -.5)">←</button>
        <button class="button-secondary button-icon" aria-label="Zoom in" title="Zoom in" @onclick="() => ChangeRange(.5, 0)">+</button>
        <button class="button-secondary button-icon" aria-label="Zoom out" title="Zoom out" @onclick="() => ChangeRange(2, 0)">−</button>
        <button class="button-secondary button-icon" aria-label="Later time range" title="Later time range" @onclick="() => ChangeRange(1, .5)">→</button>
        <button class="button-secondary" @onclick="ToggleView">@(_view == "chart" ? "Show accessible list" : "Show chart")</button>
        <button class="button-secondary" aria-pressed="@(_follow ? "true" : "false")" @onclick="FollowNow">@(_follow ? "Stop following now" : "Follow now")</button>
    </div>
    @if (_error is not null) { <p class="notice notice-error" role="alert">@_error <button class="button-quiet" @onclick="LoadAsync">Retry</button></p> }
    @if (_loading) { <p role="status">Loading native history and schedules…</p> }
    else if (_scheduler.Length == 0) { <p class="empty-state">No scheduler is available to your account.</p> }
    @if (_data is not null)
    {
        <section class="panel" aria-labelledby="timeline-heading"><div class="panel-header"><h2 id="timeline-heading">@_scheduler</h2><span>@_data.Executions.Count actual · @_data.Scheduled.Count planned</span></div>
            <p class="help-text">@Updates.GetFreshness(_scheduler).Mode · Updated @Time(_data.CapturedUtc)</p>
            @if (_data.Truncated || _inventoryTruncated) { <p class="notice">This view reached a data limit. Narrow the time range or filter.</p> }
            <div class="timeline-legend" aria-label="Timeline legend"><span class="status-badge" data-state="Running">Running</span><span class="status-badge" data-state="Completed">Completed</span><span class="status-badge" data-state="Failed">Failed</span><span>Dashed bar: manual run</span><span>Point: scheduled</span></div>
            @if (_chartError is not null) { <p class="notice notice-error" role="alert">The chart could not load. Use the accessible list below.</p> }
            <div class="execution-chart-scroll" hidden="@(_view != "chart" || _chartError is not null)" role="region" aria-label="Execution timeline. Use the accessible list for keyboard navigation." tabindex="0"><div class="execution-chart" @ref="_container"></div></div>
            <div hidden="@(_view != "list" && _chartError is null)" class="table-scroll">
                <table class="record-table" role="table"><caption>Executions and scheduled fire times — @(_zone == "local" ? _localZone.Id : "UTC")</caption><thead><tr><th scope="col">Job / trigger</th><th scope="col">Time</th><th scope="col">State</th><th scope="col">Duration / meaning</th></tr></thead><tbody>
                    @foreach (var run in _data.Executions.OrderByDescending(e => e.StartedUtc))
                    { <tr @key="run.Id"><th scope="row"><a class="entity-link" href="@RunUrl(run)">@run.JobGroup / @run.JobName</a><span class="sub-cell">@run.TriggerGroup / @run.TriggerName</span></th><td data-label="Time">@Time(run.StartedUtc)</td><td data-label="State"><span class="status-badge" data-state="@(run.CompletedUtc is null ? "Running" : run.IsError ? "Failed" : "Completed")">@(run.CompletedUtc is null ? "Running" : run.IsError ? "Failed" : "Completed")</span> @(run.IsManualRun ? "Manual" : "")</td><td data-label="Duration">@Duration(run)</td></tr> }
                    @foreach (var planned in _data.Scheduled.OrderBy(e => e.FireUtc))
                    { <tr @key="planned.Id"><th scope="row"><a class="entity-link" href="@EntityUrl("trigger", planned.TriggerGroup, planned.TriggerName)">@planned.TriggerGroup / @planned.TriggerName</a><span class="sub-cell">@planned.JobGroup / @planned.JobName</span></th><td data-label="Time">@Time(planned.FireUtc)</td><td data-label="State">Scheduled · @planned.State</td><td data-label="Meaning">Forecast only; duration unknown</td></tr> }
                    @foreach (var job in VisibleJobs().Where(j => !_data.Executions.Any(e => e.JobGroup == j.Group && e.JobName == j.Name) && !_data.Scheduled.Any(e => e.JobGroup == j.Group && e.JobName == j.Name)))
                    { <tr @key="(job.Group, job.Name)"><th scope="row"><a class="entity-link" href="@EntityUrl("job", job.Group, job.Name)">@job.Group / @job.Name</a></th><td data-label="Time">—</td><td data-label="State">No events in this range</td><td data-label="Meaning">Job exists; no execution is inferred</td></tr> }
                </tbody></table>
                @if (!VisibleJobs().Any()) { <p class="empty-state">No matching jobs or events in the available data.</p> }
            </div>
            <details class="panel-content"><summary>About this view</summary>
                <p class="help-text">@_data.Coverage @Updates.GetFreshness(_scheduler).Message</p>
                <p class="help-text">Bars show observed run duration; running bars extend only while visible. Points are planned fire times, not promised runs or estimated durations. Paused or excluded firings are not projected.</p>
                <p class="help-text">Expand a job lane for its triggers. Click a run or marker to inspect it. Use the list for keyboard navigation. The client clock pauses offscreen and with reduced motion.</p>
                <p class="help-text">Inventory and forecasts are bounded by the host's timeline limit; execution-derived lanes remain visible. Narrow the filter or range when this limit is reached.</p>
            </details>
        </section>
    }
</main>
