@page "/quartz-supervisor/timeline"
<PageTitle>Timeline · Quartz Supervisor</PageTitle>

<main class="page">
    <header class="page-heading">
        <div>
            <h1>Timeline</h1>
            <p class="page-description">Execution history and scheduler activity.</p>
        </div>
    </header>
    <section class="empty-panel timeline-empty" aria-labelledby="timeline-empty-heading">
        <span class="empty-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" /></svg>
        </span>
        <div>
            <h2 id="timeline-empty-heading">Execution history isn’t available</h2>
            <p>This dashboard does not currently retain scheduler execution events, so past runs aren’t available here.</p>
        </div>
    </section>
</main>
