@page "/quartz-supervisor/timeline"
<PageTitle>Timeline · Quartz Supervisor</PageTitle>

<main class="page" id="main-content" tabindex="-1">
    <header class="page-heading">
        <div>
            <h1>Timeline</h1>
            <p class="page-description">Live execution history · zoom, pan, and inspect each run.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-panel" role="status"><span class="loading-dot"></span>Loading job executions…</p>
    }
    else if (_error is not null)
    {
        <p class="notice" role="alert">@_error</p>
    }
    else if (_schedulers.Count == 0)
    {
        <p class="notice">No schedulers are registered with this host.</p>
    }
    else
    {
        <section class="filter-panel timeline-filter" aria-label="Timeline filters">
            <div class="filter-field">
                <label for="timeline-scheduler">Scheduler</label>
                <select id="timeline-scheduler" class="field" @bind="_selectedName" @bind:after="RefreshExecutions">
                    <option value="">All schedulers</option>
                    @foreach (var scheduler in _schedulers) { <option value="@scheduler.Name">@(scheduler.Status == "Unavailable" ? $"{scheduler.Name} (Unavailable)" : scheduler.Name)</option> }
                </select>
            </div>
            <p class="timeline-retention">Last 10 minutes · up to 100 runs per scheduler · in-process only · memory only · UTC</p>
        </section>

        <section class="timeline-panel" aria-labelledby="timeline-heading">
            <div class="panel-header">
                <div>
                    <h2 id="timeline-heading">Job executions</h2>
                    <p class="panel-description" aria-live="polite">
                        <span class="timeline-live" aria-hidden="true"></span>
                        Live · @_visibleExecutions.Count run@(_visibleExecutions.Count == 1 ? "" : "s") ·
                        @_executions.Count(run => run.CompletedUtc is null) running
                    </p>
                </div>
                <div class="timeline-controls" aria-label="Timeline controls">
                    <button class="button-secondary timeline-control" type="button" @onclick="() => ZoomAsync(1.4)" disabled="@(_visibleExecutions.Count == 0)" aria-label="Zoom out" title="Zoom out">−</button>
                    <button class="button-secondary timeline-control" type="button" @onclick="() => ZoomAsync(0.7)" disabled="@(_visibleExecutions.Count == 0)" aria-label="Zoom in" title="Zoom in">+</button>
                    <button class="button-secondary" type="button" @onclick="GoLiveAsync" disabled="@(_visibleExecutions.Count == 0)">Live now</button>
                </div>
            </div>
            <div class="timeline-legend" aria-label="Execution status legend">
                <span><i class="timeline-swatch timeline-swatch-running" aria-hidden="true"></i>Running</span>
                <span><i class="timeline-swatch timeline-swatch-completed" aria-hidden="true"></i>Completed</span>
                <span><i class="timeline-swatch timeline-swatch-failed" aria-hidden="true"></i>Failed</span>
                <span><i class="timeline-swatch timeline-swatch-manual" aria-hidden="true"></i>Manual run</span>
                <span class="timeline-interaction-hint">Drag to pan · Ctrl+scroll or pinch to zoom</span>
            </div>
            @if (_visibleExecutions.Count == 0)
            {
                <div class="empty-state">
                    <h3>No executions in the last 10 minutes</h3>
                    <p>In-process scheduler runs appear here live. Remote scheduler executions are not streamed to this dashboard.</p>
                </div>
            }
            <div class="execution-chart-scroll" role="region" aria-label="Interactive job execution timeline in UTC" tabindex="0"
                 hidden="@(_visibleExecutions.Count == 0)">
                <div class="execution-chart" @ref="_timelineContainer"></div>
            </div>
            <ol class="sr-only" aria-label="Recent job executions">
                @foreach (var run in _visibleExecutions)
                {
                    <li @key="(run.SchedulerName, run.Id)">@RunTitle(run)</li>
                }
            </ol>
        </section>
    }
</main>
