@page "/quartz-supervisor/jobs"
<PageTitle>Jobs · Quartz Supervisor</PageTitle>

<main class="page" id="main-content" tabindex="-1">
    <header class="page-heading">
        <div>
            <h1>Jobs</h1>
            <p class="page-description">Live, searchable view of jobs registered with Quartz.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-panel" role="status"><span class="loading-dot"></span>Loading jobs…</p>
    }
    else if (_error is not null)
    {
        <p class="notice" role="alert">@_error</p>
    }
    else if (_schedulers.Count == 0)
    {
        <p class="notice">No schedulers are registered with this host.</p>
    }
    else
    {
        <section class="filter-panel" aria-label="Job filters">
            <div class="filter-field">
                <label for="jobs-scheduler">Scheduler</label>
                <select id="jobs-scheduler" class="field" @bind="_selectedName" @bind:after="LoadJobsAsync">
                    @foreach (var scheduler in _schedulers) { <option value="@scheduler.Name">@(scheduler.Status == "Unavailable" ? $"{scheduler.Name} (Unavailable)" : scheduler.Name)</option> }
                </select>
            </div>
            <form class="search-form" @onsubmit="SearchJobsAsync" @onsubmit:preventDefault="true">
                <label for="job-search">Search job names</label>
                <div class="search-row">
                    <input id="job-search" class="field" type="search" @bind="_filter" @bind:event="oninput" placeholder="Job name" />
                    <button class="button-primary" type="submit">Search</button>
                </div>
            </form>
        </section>
        @if (_actionMessage is not null)
        {
            <p class="notice notice-success" role="status">@_actionMessage</p>
        }
        @if (_actionError is not null)
        {
            <p class="notice" role="alert">@_actionError</p>
        }
        <section class="table-panel" aria-labelledby="jobs-table-heading">
            <div class="panel-header table-panel-header">
                <div>
                    <h2 id="jobs-table-heading">Registered jobs</h2>
                    <p class="panel-description">Jobs on @_selectedName</p>
                </div>
            </div>
            @if (_page.Items.Count == 0)
            {
                <div class="empty-state">
                    <h3>@(!string.IsNullOrWhiteSpace(_filter) ? "No matching jobs" : _page.Skip > 0 ? "No jobs on this page" : "No jobs registered")</h3>
                    <p>@(!string.IsNullOrWhiteSpace(_filter) ? "Try another job name." : "Jobs registered with this scheduler will appear here.")</p>
                </div>
            }
            else
            {
                <div class="table-scroll desktop-table"><table>
                    <caption class="sr-only">Jobs for @_selectedName</caption>
                    <thead><tr><th scope="col">Actions</th><th scope="col">Name</th><th scope="col">Group</th><th scope="col">Description</th><th scope="col">Durable</th><th scope="col">Recovery</th></tr></thead>
                    <tbody>@foreach (var job in _page.Items)
                    {
                        <tr>
                            <td><div class="row-actions">
                                <button class="button-secondary button-icon" type="button" @onclick="() => TriggerJobAsync(job)" aria-label="@($"Run {job.Group}.{job.Name} now")" title="Run now" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                                </button>
                                <button class="button-secondary button-icon" type="button" @onclick="() => PauseJobAsync(job)" aria-label="@($"Pause {job.Group}.{job.Name}")" title="Pause" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM15 5h3v14h-3z" /></svg>
                                </button>
                                <button class="button-secondary button-icon" type="button" @onclick="() => ResumeJobAsync(job)" aria-label="@($"Resume {job.Group}.{job.Name}")" title="Resume" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4a8 8 0 1 0 7.8 9.8M20 4v6h-6" /><path d="M11 8v8l6-4z" /></svg>
                                </button>
                                <button class="button-danger button-icon" type="button" @onclick="() => DeleteJobAsync(job)" aria-label="@($"Delete {job.Group}.{job.Name}")" title="Delete" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 3v7m4-7v7" /></svg>
                                </button>
                            </div></td>
                            <th scope="row"><span class="entity-name">@job.Name</span></th>
                            <td><span class="group-tag">@job.Group</span></td>
                            <td class="description-cell">@(job.Description ?? "—")</td>
                            <td><span class="boolean-tag">@YesNo(job.Durable)</span></td>
                            <td><span class="boolean-tag">@YesNo(job.RequestsRecovery)</span></td>
                        </tr>
                    }</tbody>
                </table></div>
                <div class="mobile-records" role="list" aria-label="Jobs for @_selectedName">
                    @foreach (var job in _page.Items)
                    {
                        <article class="mobile-record" role="listitem">
                            <header class="mobile-record-heading">
                                <h3>@job.Name</h3>
                                <span class="group-tag">Group · @job.Group</span>
                            </header>
                            <p class="mobile-description">@(job.Description ?? "No description")</p>
                            <dl class="mobile-facts">
                                <div><dt>Durable</dt><dd>@YesNo(job.Durable)</dd></div>
                                <div><dt>Recovery</dt><dd>@YesNo(job.RequestsRecovery)</dd></div>
                            </dl>
                            <div class="row-actions">
                                <button class="button-secondary button-icon" type="button" @onclick="() => TriggerJobAsync(job)" aria-label="@($"Run {job.Group}.{job.Name} now")" title="Run now" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                                </button>
                                <button class="button-secondary button-icon" type="button" @onclick="() => PauseJobAsync(job)" aria-label="@($"Pause {job.Group}.{job.Name}")" title="Pause" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM15 5h3v14h-3z" /></svg>
                                </button>
                                <button class="button-secondary button-icon" type="button" @onclick="() => ResumeJobAsync(job)" aria-label="@($"Resume {job.Group}.{job.Name}")" title="Resume" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4a8 8 0 1 0 7.8 9.8M20 4v6h-6" /><path d="M11 8v8l6-4z" /></svg>
                                </button>
                                <button class="button-danger button-icon" type="button" @onclick="() => DeleteJobAsync(job)" aria-label="@($"Delete {job.Group}.{job.Name}")" title="Delete" disabled="@_acting">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 3v7m4-7v7" /></svg>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
            @if (_page.Skip > 0 || _page.HasMore)
            {
                <nav class="pager" aria-label="Job pages">
                    <span>Page @PageNumber</span>
                    <div class="pager-actions">
                        <button class="button-secondary" type="button" @onclick="PreviousPageAsync" disabled="@(_page.Skip == 0)">Previous</button>
                        <button class="button-secondary" type="button" @onclick="NextPageAsync" disabled="@(!_page.HasMore)">Next <span aria-hidden="true">→</span></button>
                    </div>
                </nav>
            }
        </section>
    }
</main>
