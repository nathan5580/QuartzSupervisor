@page "/jobs"
<PageTitle>Jobs · @Context.Title</PageTitle>
<main class="page" id="main-content" tabindex="-1">
    <header class="page-heading"><div><h1>Jobs</h1><p class="page-description">A job defines the work; a trigger schedules when it runs. Run jobs, inspect results, and manage schedules on @Context.SchedulerName.</p></div>
        @if (_admin) { <a class="button-primary" href="@Context.Url("job", query: new Dictionary<string, string?> { ["create"] = "true" })">Create job</a> }
    </header>
    <form class="toolbar" @onsubmit="SearchJobs" @onsubmit:preventDefault="true">
        <div class="form-field"><label for="jobs-search">Search</label><input id="jobs-search" type="search" @bind="_search" placeholder="Job name" /></div>
        <div class="form-field"><label for="jobs-group">Group</label><input id="jobs-group" @bind="_group" placeholder="All groups" /></div>
        <div class="form-field"><label for="jobs-state">State</label><select id="jobs-state" @bind="_state"><option value="">All states</option>@foreach (var state in new[] { "Normal", "Paused", "Running", "Error", "Unscheduled", "Complete", "Blocked" }) { <option>@state</option> }</select></div>
        <button class="button-secondary" type="submit">Apply filters</button>
        <a class="button-quiet" href="@Context.Url("jobs")">Clear</a>
    </form>
    @if (_loading) { <p role="status" class="text-muted">Refreshing jobs…</p> }
    @if (_error is not null) { <p class="notice notice-error" role="alert">@_error <button class="button-quiet" @onclick="LoadAsync">Retry</button></p> }
    @if (_message is not null) { <p class="notice notice-success" role="status">@_message</p> }
    @if (_selected.Count > 0)
    {
        var selectedRows = _page.Items.Where(x => _selected.Contains(new(x.Group, x.Name))).ToArray();
        <section class="selection-bar" aria-label="Selected jobs"><strong>@_selected.Count selected (up to 100)</strong>
            @if (_operate && selectedRows.Any(x => x.State != "Paused")) { <button class="button-secondary" disabled="@_acting" @onclick='() => BulkAsync("pause")'>Pause selected</button> }
            @if (_operate && selectedRows.Any(x => x.State == "Paused")) { <button class="button-secondary" disabled="@_acting" @onclick='() => BulkAsync("resume")'>Resume selected</button> }
            @if (selectedRows.Any(x => x.State == "Paused") && selectedRows.Any(x => x.State != "Paused")) { <span class="help-text">Mixed states: each action applies to the full selection.</span> }
            @if (_admin) { <button class="button-danger" disabled="@_acting" @onclick='() => BulkAsync("delete")'>Delete selected…</button> }
            <button class="button-quiet" @onclick="() => _selected.Clear()">Clear selection</button>
        </section>
    }
    @if (_outcomes.Any(x => !x.Succeeded))
    {
        <div class="notice notice-error" role="alert"><strong>Some jobs were not changed</strong><ul>@foreach (var result in _outcomes.Where(x => !x.Succeeded)) { <li>@result.Group / @result.Name: @result.Error</li> }</ul><p>Successful actions were retained. Retry only the remaining selection.</p></div>
    }
    <section class="table-panel" aria-label="Registered jobs" aria-busy="@((_loading || _acting) ? "true" : "false")">
        <div class="table-scroll" tabindex="0" role="region" aria-label="Job table"><table class="record-table" role="table">
            <caption class="sr-only">Jobs for @Context.SchedulerName. Times shown in UTC.</caption>
            <thead><tr>@if (_operate || _admin) { <th scope="col"><label class="checkbox-target"><input type="checkbox" aria-label="Select up to 100 jobs on this page" checked="@(_page.Items.Count > 0 && _selected.Count == Math.Min(100, _page.Items.Count))" @onchange="SelectAll" /></label></th> }<th scope="col">Job</th><th scope="col">State</th><th scope="col">Next run</th><th scope="col">Last result</th><th scope="col">Actions</th></tr></thead>
            <tbody>@foreach (var job in _page.Items)
            {
                <tr @key="(job.Group, job.Name)">
                    @if (_operate || _admin) { <td class="record-select"><label class="checkbox-target"><input type="checkbox" aria-label="@($"Select {job.Group} / {job.Name}")" checked="@_selected.Contains(new(job.Group, job.Name))" disabled="@(_selected.Count >= 100 && !_selected.Contains(new(job.Group, job.Name)))" @onchange="e => Select(job, e)" /></label></td> }
                    <th scope="row"><a class="entity-link" href="@JobUrl(job)">@job.Name</a><span class="sub-cell">@job.Group · @job.TriggerCount schedule(s)</span>@if (!string.IsNullOrEmpty(job.Description)) { <span class="sub-cell">@job.Description</span> }</th>
                    <td data-label="State"><span><span class="status-badge" data-state="@job.State">@job.State</span>@if (job.RunningCount > 0) { <span class="sub-cell">@job.RunningCount running</span> }</span></td>
                    <td class="time-cell" data-label="Next run">@Time(job.NextFireTimeUtc)</td>
                    <td data-label="Last result"><span>@(job.LastCompletedUtc is null ? "No recorded result" : job.LastRunFailed == true ? "Failed" : "Completed")<span class="sub-cell">@Time(job.LastCompletedUtc)</span></span></td>
                    <td class="record-actions"><div class="row-actions">
                        @if (_operate) { <button class="button-secondary" disabled="@_acting" @onclick="() => RunAsync(job)" aria-label="@($"Run {job.Name} now")">Run now</button> }
                        <details class="action-menu"><summary>More<span class="sr-only"> actions for @job.Name</span></summary><div class="row-actions">
                            <a class="button-quiet" href="@JobUrl(job)">Details</a>
                            @if (_operate && job.TriggerCount > 0) { <button class="button-secondary" disabled="@_acting" @onclick='() => BulkAsync(job.State == "Paused" ? "resume" : "pause", job)'>@(job.State == "Paused" ? "Resume" : "Pause")</button> }
                            @if (_admin) { <button class="button-danger" disabled="@_acting" @onclick='() => BulkAsync("delete", job)'>Delete…</button> }
                        </div></details>
                    </div></td>
                </tr>
            }</tbody>
        </table></div>
        @if (!_loading && _page.Items.Count == 0) { <div class="empty-state"><h2>No jobs found</h2><p>Adjust the filters, select a scheduler, or create a host-approved job.</p></div> }
        <nav class="pager" aria-label="Job pages"><span>Page @(_page.Skip / Math.Max(1, _page.PageSize) + 1)</span><div class="pager-actions">@if (_page.Skip > 0) { <a class="button-secondary" href="@PageUrl(Math.Max(0, _page.Skip - _page.PageSize))">Previous</a> }@if (_page.HasMore) { <a class="button-secondary" href="@PageUrl(_page.Skip + _page.PageSize)">Next</a> }</div></nav>
    </section>
</main>
