@page "/quartz-supervisor/triggers"
<PageTitle>Triggers · Quartz Supervisor</PageTitle>

<main class="page" id="main-content" tabindex="-1">
    <header class="page-heading">
        <div>
            <h1>Triggers</h1>
            <p class="page-description">Live, searchable view of trigger state and upcoming fire times.</p>
        </div>
    </header>

    @if (_loading)
    {
        <p class="state-panel" role="status"><span class="loading-dot"></span>Loading triggers…</p>
    }
    else if (_error is not null)
    {
        <p class="notice" role="alert">@_error</p>
    }
    else if (_schedulers.Count == 0)
    {
        <p class="notice">No schedulers are registered with this host.</p>
    }
    else
    {
        <section class="filter-panel" aria-label="Trigger filters">
            <div class="filter-field">
                <label for="triggers-scheduler">Scheduler</label>
                <select id="triggers-scheduler" class="field" @bind="_selectedName" @bind:after="LoadTriggersAsync">
                    @foreach (var scheduler in _schedulers) { <option value="@scheduler.Name">@(scheduler.Status == "Unavailable" ? $"{scheduler.Name} (Unavailable)" : scheduler.Name)</option> }
                </select>
            </div>
            <form class="search-form" @onsubmit="SearchTriggersAsync" @onsubmit:preventDefault="true">
                <label for="trigger-search">Search trigger names</label>
                <div class="search-row">
                    <input id="trigger-search" class="field" type="search" @bind="_filter" @bind:event="oninput" placeholder="Trigger name" />
                    <button class="button-primary" type="submit">Search</button>
                </div>
            </form>
        </section>
        @if (_actionMessage is not null)
        {
            <p class="notice notice-success" role="status">@_actionMessage</p>
        }
        @if (_actionError is not null)
        {
            <p class="notice" role="alert">@_actionError</p>
        }
        <section class="table-panel" aria-labelledby="triggers-table-heading">
            <div class="panel-header table-panel-header">
                <div>
                    <h2 id="triggers-table-heading">Registered triggers</h2>
                    <p class="panel-description">Schedules on @_selectedName</p>
                </div>
            </div>
            @if (_page.Items.Count == 0)
            {
                <div class="empty-state">
                    <h3>@(!string.IsNullOrWhiteSpace(_filter) ? "No matching triggers" : _page.Skip > 0 ? "No triggers on this page" : "No triggers registered")</h3>
                    <p>@(!string.IsNullOrWhiteSpace(_filter) ? "Try another trigger name." : "Triggers registered with this scheduler will appear here.")</p>
                </div>
            }
            else
            {
                <div class="table-scroll desktop-table"><table>
                    <caption class="sr-only">Triggers for @_selectedName</caption>
                    <thead><tr><th scope="col">Actions</th><th scope="col">Name</th><th scope="col">Group</th><th scope="col">Job</th><th scope="col">State</th><th scope="col">Next fire (UTC)</th><th scope="col">Previous fire (UTC)</th></tr></thead>
                    <tbody>@foreach (var trigger in _page.Items)
                    {
                        <tr>
                            <td>
                                @if (trigger.IsManualRun)
                                {
                                    <span class="sr-only">One-shot trigger has no trigger actions.</span>
                                }
                                else
                                {
                                    <div class="row-actions">
                                        @if (trigger.State == "Paused")
                                        {
                                            <button class="button-secondary" type="button" @onclick="() => ResumeTriggerAsync(trigger)" aria-label="@($"Resume {trigger.Group}.{trigger.Name}")" disabled="@_acting">Resume</button>
                                        }
                                        else
                                        {
                                            <button class="button-secondary" type="button" @onclick="() => PauseTriggerAsync(trigger)" aria-label="@($"Pause {trigger.Group}.{trigger.Name}")" disabled="@_acting">Pause</button>
                                        }
                                        <button class="button-danger" type="button" @onclick="() => DeleteTriggerAsync(trigger)" aria-label="@($"Delete {trigger.Group}.{trigger.Name}")" disabled="@_acting">Delete</button>
                                    </div>
                                }
                            </td>
                            <th scope="row">
                                <span class="entity-name">@(trigger.IsManualRun ? "Manual run" : trigger.Name)</span>
                                @if (trigger.IsManualRun) { <span class="manual-run-badge">One-shot</span> }
                            </th>
                            <td><span class="group-tag">@(trigger.IsManualRun ? "Dashboard" : trigger.Group)</span></td>
                            <td><span class="entity-name">@trigger.JobName</span><span class="sub-cell">(@trigger.JobGroup)</span></td>
                            <td><span class="state-badge" data-state="@trigger.State">@trigger.State</span></td>
                            <td class="time-cell">@FormatTime(trigger.NextFireTimeUtc)</td>
                            <td class="time-cell">@FormatTime(trigger.PreviousFireTimeUtc)</td>
                        </tr>
                    }</tbody>
                </table></div>
                <div class="mobile-records" role="list" aria-label="Triggers for @_selectedName">
                    @foreach (var trigger in _page.Items)
                    {
                        <article class="mobile-record" role="listitem">
                            <header class="mobile-record-heading">
                                <h3>@(trigger.IsManualRun ? "Manual run" : trigger.Name)</h3>
                                @if (trigger.IsManualRun)
                                {
                                    <span class="manual-run-badge">One-shot</span>
                                }
                                else
                                {
                                    <span class="group-tag">Group · @trigger.Group</span>
                                }
                            </header>
                            <p class="mobile-related-job">Job: @trigger.JobName <span class="sub-cell">(@trigger.JobGroup)</span></p>
                            <dl class="mobile-facts">
                                <div><dt>State</dt><dd><span class="state-badge" data-state="@trigger.State">@trigger.State</span></dd></div>
                                <div><dt>Next fire (UTC)</dt><dd>@FormatTime(trigger.NextFireTimeUtc)</dd></div>
                                <div><dt>Previous fire (UTC)</dt><dd>@FormatTime(trigger.PreviousFireTimeUtc)</dd></div>
                            </dl>
                            @if (trigger.IsManualRun)
                            {
                                <p class="mobile-run-note">Temporary one-shot trigger from Run now; not a saved schedule.</p>
                            }
                            else
                            {
                                <div class="row-actions">
                                    @if (trigger.State == "Paused")
                                    {
                                        <button class="button-secondary" type="button" @onclick="() => ResumeTriggerAsync(trigger)" aria-label="@($"Resume {trigger.Group}.{trigger.Name}")" disabled="@_acting">Resume</button>
                                    }
                                    else
                                    {
                                        <button class="button-secondary" type="button" @onclick="() => PauseTriggerAsync(trigger)" aria-label="@($"Pause {trigger.Group}.{trigger.Name}")" disabled="@_acting">Pause</button>
                                    }
                                    <button class="button-danger" type="button" @onclick="() => DeleteTriggerAsync(trigger)" aria-label="@($"Delete {trigger.Group}.{trigger.Name}")" disabled="@_acting">Delete</button>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            @if (_page.Skip > 0 || _page.HasMore)
            {
                <nav class="pager" aria-label="Trigger pages">
                    <span>Page @PageNumber</span>
                    <div class="pager-actions">
                        <button class="button-secondary" type="button" @onclick="PreviousPageAsync" disabled="@(_page.Skip == 0)">Previous</button>
                        <button class="button-secondary" type="button" @onclick="NextPageAsync" disabled="@(!_page.HasMore)">Next <span aria-hidden="true">→</span></button>
                    </div>
                </nav>
            }
        </section>
    }
</main>
