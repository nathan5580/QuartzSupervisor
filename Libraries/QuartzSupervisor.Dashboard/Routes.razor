<Router AppAssembly="typeof(DashboardApp).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(DashboardLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(DashboardLayout)">
            <main><h1>Page not found</h1><p><a href="/quartz-supervisor">Return to overview</a></p></main>
        </LayoutView>
    </NotFound>
</Router>
